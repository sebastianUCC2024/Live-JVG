{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoreUpdate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "event_id",
    "event_type",
    "home_score",
    "away_score",
    "updated_at",
    "var_status"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "event_type": {
      "enum": [
        "GOAL",
        "VAR_CHECK",
        "GOAL_ANNULLED",
        "MATCH_CONTINUES"
      ]
    },
    "home_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "away_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "var_status": {
      "enum": [
        "CLEAR",
        "IN_PROGRESS"
      ]
    },
    "reference_event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "GOAL_ANNULLED"
          }
        }
      },
      "then": {
        "required": [
          "reference_event_id"
        ],
        "properties": {
          "reference_event_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "description": "Existing Match State AMQP body consumed by Dashboard and Notification. reference_event_id identifies the original GOAL for GOAL_ANNULLED. application_seq is an AMQP header, not a body field; stream_id and revision belong to the Dashboard REST/STOMP envelope. Enable date-time format assertions. JSON Schema does not check goal existence, identity conflicts or event ordering."
}
