# Copiar a .env y completar las dos contraseñas; no versionar el archivo resultante.
MVP_DB_PASSWORD=
MVP_RABBIT_PASSWORD=
MVP_MATCH_ID=mvp-match-001

# PostgreSQL local; las mismas variables permiten seleccionar una base externa.
JVG_DB_MODE=local
JVG_DB_HOST=postgres
JVG_DB_PORT=5432
JVG_DB_NAME=live_jvg
JVG_DB_USER=live_jvg
JVG_DB_OPTIONS=
JVG_PGSSLMODE=prefer

# Activación explícita de simulación y alertas.
SIMULATOR_WRITE_ENABLED=true
SIMULATOR_AUTO_ENABLED=false
SIMULATOR_AUTO_INTERVAL_MS=1000
SIMULATOR_RESET_KEY=
MATCH_STATE_ALERTS_ENABLED=false
MATCH_STATE_ALERTS_PUBLICATION_ENABLED=false
NOTIFICATION_STORAGE_ENABLED=false
NOTIFICATION_MESSAGING_ENABLED=false
NOTIFICATION_LIVE_ALERTS_ENABLED=false
NOTIFICATION_MATCH_IDS=demo-col-v4-001,demo-col-v4-002,demo-col-v4-003,demo-col-v4-004,demo-col-v4-005,demo-col-v4-006

# integration-prepared incluye contenedores; los procesos opcionales siguen desactivados.
ARCHIVER_CONSUMER_ENABLED=false
BETTING_CONTROL_CONSUMER_ENABLED=false
BETTING_CONTROL_PUBLICATION_ENABLED=false
BETTING_WORKER_CONSUMER_ENABLED=false
BETTING_WORKER_ACCEPTANCE_ENABLED=false
BETTING_WORKER_AUTHORIZATION_MODE=disabled
ACADEMIC_COMMANDS_ENABLED=false
ACADEMIC_PUBLICATION_ENABLED=false
ACADEMIC_CONSUMER_ENABLED=false
ACADEMIC_TOPOLOGY_ENABLED=false
# Las migraciones y el arranque automático se controlan por servicio: ARCHIVER_*, BETTING_CONTROL_*, BETTING_WORKER_* y NOTIFICATION_*.

# Direcciones del navegador; no utilizar los nombres internos de servicio de Docker.
VITE_API_URL=http://localhost:18080
VITE_WS_URL=ws://localhost:18080/ws
VITE_NOTIFICATION_ORIGIN=http://localhost:18082

# Valores del antiguo overlay AWS, solo para un despliegue autorizado.
# JVG_DB_MODE=external
# JVG_DB_HOST=live-jvg-postgres.c03ye40kiikw.us-east-1.rds.amazonaws.com
# JVG_DB_OPTIONS=?sslmode=require
# JVG_PGSSLMODE=require
# JVG_DB_HEALTH_INTERVAL=10s
# JVG_DB_HEALTH_TIMEOUT=5s
# JVG_DB_HEALTH_RETRIES=15
# DASHBOARD_ALLOWED_ORIGINS=https://livejvg.duckdns.org
# NOTIFICATION_ALLOWED_ORIGINS=https://livejvg.duckdns.org
# VITE_WS_URL=wss://livejvg.duckdns.org/ws
