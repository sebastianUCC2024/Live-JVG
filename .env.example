# MATCH_STATE_ALERTS_PUBLICATION_ENABLED=true
# NOTIFICATION_STORAGE_ENABLED=true
# NOTIFICATION_MESSAGING_ENABLED=true
# NOTIFICATION_LIVE_ALERTS_ENABLED=true
# NOTIFICATION_AMQP_AUTO_STARTUP=true
