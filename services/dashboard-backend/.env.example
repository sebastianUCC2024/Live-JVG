# Template only: Spring Boot does not automatically load this file.
# Export values in the process using DEV 3's approved connection settings.
# Durable host mode (memory mode uses 8081 and AMQP 5672 instead).
DASHBOARD_PORT=8080
RABBITMQ_HOST=127.0.0.1
# Default in code, not confirmation of DEV 3's exposed Docker port.
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=REPLACE_WITH_APPROVED_USER
RABBITMQ_PASSWORD=REPLACE_WITH_LOCAL_VALUE
RABBITMQ_EXCHANGE=live_updates
DASHBOARD_RABBIT_LISTENER_ENABLED=true
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DASHBOARD_DB_URL=jdbc:postgresql://127.0.0.1:55434/live_jvg
PRODUCER_URL=http://127.0.0.1:18081
PRODUCER_CONNECT_TIMEOUT=2s
PRODUCER_READ_TIMEOUT=5s
SIMULATOR_WRITE_ENABLED=false
