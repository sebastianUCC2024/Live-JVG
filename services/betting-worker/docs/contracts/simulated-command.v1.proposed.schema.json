{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaceSimulatedOperation proposal, not approved",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "operation_id",
    "match_id",
    "simulated_user_id",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "simulated_user_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Local worker decoder proposal only. No amount, payment or authorization evidence accepted from this command. Enable date-time format assertions in any future schema validator."
}
