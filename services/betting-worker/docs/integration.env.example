# Example only. Supply a NEW approved isolated database; no credentials are committed.
SPRING_PROFILES_ACTIVE=dev3-integration
DEV3_WORKER_HTTP_PORT=18884
DEV3_WORKER_DB_URL=
DEV3_WORKER_DB_USERNAME=
DEV3_WORKER_DB_PASSWORD=
DEV3_RABBITMQ_HOST=
DEV3_RABBITMQ_PORT=
DEV3_RABBITMQ_USERNAME=
DEV3_RABBITMQ_PASSWORD=

# Future atomic authority; leave disabled/empty until database, roles, leases and tests are approved.
BETTING_WORKER_AUTHORIZATION_MODE=disabled
BETTING_WORKER_AUTHORITY_DATABASE=
BETTING_WORKER_AUTHORITY_EPOCH=

# Common authority override: select profiles in this order only after provisioning a NEW database.
# SPRING_PROFILES_ACTIVE=dev3-integration,dev3-authority
DEV3_AUTHORITY_DB_URL=
DEV3_RABBITMQ_VHOST=
DEV3_WORKER_EXCHANGE=
DEV3_WORKER_QUEUE=
