# Documentation only: Spring does not load this file automatically.
# Keep these OFF until the team approves the infrastructure and migration.
NOTIFICATION_STORAGE_ENABLED=false
NOTIFICATION_MESSAGING_ENABLED=false
NOTIFICATION_BIND_ADDRESS=127.0.0.1
NOTIFICATION_PORT=8082
# Proposed local port; coordinate with DEV 3 before deployment.
NOTIFICATION_DB_URL=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_RABBIT_HOST=localhost
NOTIFICATION_RABBIT_PORT=5673
NOTIFICATION_RABBIT_USERNAME=
NOTIFICATION_RABBIT_PASSWORD=
NOTIFICATION_EXCHANGE=live_updates
NOTIFICATION_QUEUE=notification.score-updates
# Required authorized IDs for activation, comma-separated; no generated default.
NOTIFICATION_MATCH_IDS=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_INTERVAL_MS=1000
NOTIFICATION_CONFIRM_TIMEOUT=5s
# Empty by default; configure exact HTTP(S) origins only after delivery approval.
NOTIFICATION_ALLOWED_ORIGINS=
