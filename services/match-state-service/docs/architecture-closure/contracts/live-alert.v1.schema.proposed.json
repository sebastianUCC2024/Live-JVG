{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "live-alert V1 proposal (NOT APPROVED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "alert_id",
    "match_id",
    "alert_type",
    "source_event_id",
    "source_updated_at",
    "created_at",
    "reference_event_id",
    "home_score",
    "away_score",
    "var_status",
    "content"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "alert_type": {
      "enum": [
        "GOAL",
        "VAR_CHECK",
        "GOAL_ANNULLED",
        "MATCH_CONTINUES"
      ]
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference_event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "home_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "away_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "var_status": {
      "enum": [
        "CLEAR",
        "IN_PROGRESS"
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "locale",
        "title",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
