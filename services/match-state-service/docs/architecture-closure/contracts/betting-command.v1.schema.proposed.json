{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "betting-command V1 proposal (NOT APPROVED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "operation_id",
    "match_id",
    "simulated_user_id",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "simulated_user_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
