{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicCommand V1 (local academic contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "match_id",
    "source_event_id",
    "command_type",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1
    },
    "command_type": {
      "enum": [
        "SUSPEND_BETS",
        "RESUME_BETS"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
