{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Betting state notification proposal, NOT an authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "match_id",
    "version",
    "event_type",
    "status",
    "bets_allowed",
    "source_event_id",
    "cause_id",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "match_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "BETTING_SUSPENDED",
        "BETTING_RESUMED"
      ]
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "SUSPENDED",
        "OPEN"
      ]
    },
    "bets_allowed": {
      "type": "boolean"
    },
    "source_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "BETTING_RESUMED"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "OPEN"
          },
          "bets_allowed": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "enum": [
              "UNKNOWN",
              "SUSPENDED"
            ]
          },
          "bets_allowed": {
            "const": false
          }
        }
      }
    }
  ],
  "description": "Aggregate revision can have gaps. Consumers deduplicate message_id and never infer authorization from notification or updated_at alone. No topology approved."
}
