# Legacy memory mode. For local Compose use ws://127.0.0.1:18080/ws and its actual match ID.
VITE_WS_URL=ws://127.0.0.1:8081/ws
# Alternative: remove VITE_WS_URL and set VITE_DASHBOARD_ORIGIN=http://127.0.0.1:18080
VITE_MATCH_IDS=match-001
# Optional operator-supplied labels; these are not backend JSON fields.
VITE_MATCH_METADATA={"match-001":{"home":"Equipo local","away":"Equipo visitante"}}
