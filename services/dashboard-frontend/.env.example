# Durable MVP: React discovers match IDs and team names through REST.
VITE_DASHBOARD_ORIGIN=http://127.0.0.1:18080
# Optional durable alerts. Use the HTTP origin/port approved by infrastructure.
# VITE_NOTIFICATION_ORIGIN=http://127.0.0.1:8082
# Leave unset for memory/demo; no credentials in VITE_ variables.
# Optional override (also determines REST origin): VITE_WS_URL=ws://127.0.0.1:18080/ws
# Memory: VITE_DASHBOARD_ORIGIN=http://127.0.0.1:8081
# Optional manual fallback, not a replacement for the durable catalog:
# VITE_MATCH_IDS=match-001
# Optional operator-supplied labels; these are not backend JSON fields.
# VITE_MATCH_METADATA={"match-001":{"home":"Equipo local","away":"Equipo visitante"}}
